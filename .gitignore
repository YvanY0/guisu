# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# IDE and editor files
.vscode/
.idea/
.zed/
*.swp
*.swo
*~

# Local development
.env
.env.local
*.local

# AI/Coding Assistant artifacts
# Note: .claude/ is intentionally tracked (harness configuration is
# shared with collaborators). The other entries below remain ignored.
.mcp.json
openspec/
.full-review/
# Brainstorming/planning artifacts from superpowers skills. Specs
# and plans are session-local working documents; we do not ship them.
docs/superpowers/

# Documentation build artifacts
/docs/_build/
/docs/.doctrees/

# Zensical build output (cache dir .cache/ is matched by *.cache in user-global gitignore)
site/
.cache/

# Coverage reports
*.gcda
*.gcno
*.gcov
*.lcov
coverage/
lcov.info

# Logs
*.log
